{
  "name": "madvisual",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "elysia": "^1.4.21",
      "@trpc/server": "^11.7.2",
      "better-auth": "1.5.2",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@trpc/client": "^11.7.2",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "dev:web": "nx run-many -t dev --projects=web",
    "dev:server": "nx run-many -t dev --projects=server",
    "db:push": "nx run-many -t db:push --projects=@madvisual/db",
    "db:studio": "nx run-many -t db:studio --projects=@madvisual/db",
    "db:generate": "nx run-many -t db:generate --projects=@madvisual/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@madvisual/db",
    "db:start": "nx run-many -t db:start --projects=@madvisual/db",
    "db:watch": "nx run-many -t db:watch --projects=@madvisual/db",
    "db:stop": "nx run-many -t db:stop --projects=@madvisual/db",
    "db:down": "nx run-many -t db:down --projects=@madvisual/db",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@madvisual/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@madvisual/config": "workspace:*",
    "@types/bun": "catalog:",
    "nx": "^21.5.2",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.8"
}
